---
interface Props {
  className?: string;
}

const { className = "brand-logo-svg" } = Astro.props;
---

<svg class={className} viewBox="0 0 80 80" fill="none" aria-hidden="true" focusable="false">
  <circle cx="40" cy="40" r="16" stroke="currentColor" stroke-width="2" />
  <circle cx="40" cy="40" r="4.5" fill="currentColor" />
  <g class="cma-orbit" fill="currentColor">
    <circle cx="40" cy="12" r="2.4" />
    <circle cx="66.6" cy="31.3" r="2.4" />
    <circle cx="56.5" cy="62.7" r="2.4" />
    <circle cx="23.5" cy="62.7" r="2.4" />
    <circle cx="13.4" cy="31.3" r="2.4" />
  </g>
</svg>
