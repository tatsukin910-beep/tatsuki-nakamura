---
import OrbitalLogo from './OrbitalLogo.astro';

interface Props {
  versionText?: string;
  homeHref?: string;
  gateHref?: string;
}

const {
  versionText = "参照定義：v2.1",
  homeHref = "/portal/",
  gateHref = "/"
} = Astro.props;

const pathname = Astro.url.pathname;
const navLinks = [
  { href: "/portal/", label: "HOME", match: (p: string) => p === "/portal" || p === "/portal/" || p === "/portal/index.html" },
  { href: "/portal/framework/", label: "02 5層モデル", match: (p: string) => p.startsWith("/portal/framework") },
  { href: "/portal/archive/", label: "06 資料・方法", match: (p: string) => p.startsWith("/portal/archive") },
  { href: "/portal/about/", label: "08 プロフィール", match: (p: string) => p.startsWith("/portal/about") },
  { href: "/portal/contact/", label: "09 お問い合わせ", match: (p: string) => p.startsWith("/portal/contact") },
  { href: "/portal/support/", label: "14 ご支援", match: (p: string) => p.startsWith("/portal/support") },
];
---

<header id="cma-header">
  <div class="inner">
    <a class="gate-link" href={gateHref}>入口</a>
    <a href={homeHref} class="brand-group" aria-label="CMA ホームへ">
      <OrbitalLogo />
      <div>
        <div class="cma-title">CMA</div>
        <div class="cma-sub">中村達希</div>
      </div>
    </a>
    <div class="header-tools">
      <button type="button" id="contrast-toggle" class="contrast-toggle" aria-pressed="false">白黒反転</button>
      <p id="theme-status" class="visually-hidden" aria-live="polite"></p>
      <div class="ver-badge">{versionText}</div>
    </div>
  </div>
  <nav class="portal-subnav" aria-label="研究ポータルナビゲーション">
    <ul>
      {navLinks.map((item) => {
        const isCurrent = item.match(pathname);
        return (
          <li>
            <a href={item.href} aria-current={isCurrent ? "page" : undefined}>
              {item.label}
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
</header>
