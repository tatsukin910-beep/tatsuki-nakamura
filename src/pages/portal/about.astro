---
import PortalLayout from '../../layouts/PortalLayout.astro';
import SectionNav from '../../components/SectionNav.astro';
---

<PortalLayout
  title="08 研究者プロフィール｜CMA 公式研究サイト"
  description="当事者研究者・独立研究者 中村達希のプロフィール、研究領域、公式学術リンク（ORCID、Google Scholar、GitHub等）。"
  canonicalUrl="https://tatsuki-nakamura.com/portal/about/"
>
  <div id="section08">
    <section id="cma08-content" class="cma08-wrap" aria-labelledby="s08-title" lang="ja">
      <div class="cma08-card">
        <header class="cma08-header">
          <span class="cma08-badge">08 About Researcher</span>
          <h1 id="s08-title" class="cma08-name">中村 達希</h1>
          <div class="cma08-en-name">Tatsuki Nakamura</div>
          <div class="cma08-role">当事者研究者・独立研究者（元介護職員）</div>
        </header>
        <div class="cma08-bio">
          <p>
            複合的多層的虐待（Complex Multilayered Abuse: CMA）の構造分析・当事者研究に従事。閉鎖環境において虐待構造が自己補強的に維持される過程と、その持続的影響を非診断的な視座から客観的に解明する枠組みの構築を行っています。
          </p>
        </div>
        <h2 class="cma08-links-title">公式リンク・学術ID・発信一覧</h2>
        <div class="cma08-links-grid">
          <a href="https://note.com/tatsu97910" class="cma08-link-card" target="_blank" rel="noopener noreferrer">
            <div class="cma08-link-info">
              <strong>note</strong>
              <span>日々の思考・エッセイ・手記</span>
            </div>
            <span class="cma08-link-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="https://orcid.org/0009-0004-9696-7896" class="cma08-link-card" target="_blank" rel="noopener noreferrer">
            <div class="cma08-link-info">
              <strong class="orcid-heading">
                <svg class="orcid-icon" viewBox="0 0 256 256" width="16" height="16" aria-hidden="true" focusable="false">
                  <path fill="#A6CE39" d="M256,128c0,70.7-57.3,128-128,128C57.3,256,0,198.7,0,128C0,57.3,57.3,0,128,0C198.7,0,256,57.3,256,128z"/>
                  <g fill="#FFFFFF">
                    <path d="M86.3,186.2H70.9V79.1h15.4v107.1z"/>
                    <path d="M108.9,79.1h41.6c39.6,0,57,28.3,57,53.6c0,27.5-21.5,53.6-56.8,53.6h-41.8V79.1z M124.3,172.4h24.5c34.9,0,42.9-26.5,42.9-39.7c0-21.5-13.7-39.7-43.7-39.7h-23.7V172.4z"/>
                    <path d="M88.7,56.8c0,5.5-4.5,10.1-10.1,10.1c-5.6,0-10.1-4.6-10.1-10.1c0-5.6,4.5-10.1,10.1-10.1C84.2,46.7,88.7,51.3,88.7,56.8z"/>
                  </g>
                </svg>
                ORCID
              </strong>
              <span>0009-0004-9696-7896</span>
            </div>
            <span class="cma08-link-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="https://x.com/tatsu97910" class="cma08-link-card" target="_blank" rel="noopener noreferrer">
            <div class="cma08-link-info">
              <strong>X (@tatsu97910)</strong>
              <span>最新の活動・研究ポスト</span>
            </div>
            <span class="cma08-link-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="https://github.com/tatsukin910-beep/cma-theory-core" class="cma08-link-card" target="_blank" rel="noopener noreferrer">
            <div class="cma08-link-info">
              <strong>GitHub</strong>
              <span>cma-theory-core リポジトリ</span>
            </div>
            <span class="cma08-link-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="https://scholar.google.com/citations?user=NcwwIIwAAAAJ&hl=ja" class="cma08-link-card" target="_blank" rel="noopener noreferrer">
            <div class="cma08-link-info">
              <strong>Google Scholar</strong>
              <span>研究者プロファイル</span>
            </div>
            <span class="cma08-link-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="https://tayo.jp/users/01KSZKVJV1J84SDB73DHN6CAX0" class="cma08-link-card" target="_blank" rel="noopener noreferrer">
            <div class="cma08-link-info">
              <strong>tayo.jp</strong>
              <span>研究者プラットフォーム</span>
            </div>
            <span class="cma08-link-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="https://paperlens.science/app/profile/tatsu97910" class="cma08-link-card" target="_blank" rel="noopener noreferrer">
            <div class="cma08-link-info">
              <strong>PaperLens</strong>
              <span>論文分析プロファイル</span>
            </div>
            <span class="cma08-link-arrow" aria-hidden="true">↗</span>
          </a>
          <a href="https://www.youtube.com/@tatsuki-nakamura" class="cma08-link-card" target="_blank" rel="noopener noreferrer">
            <div class="cma08-link-info">
              <strong>YouTube</strong>
              <span>@tatsuki-nakamura</span>
            </div>
            <span class="cma08-link-arrow" aria-hidden="true">↗</span>
          </a>
        </div>
        <SectionNav
          prev={{ href: "/portal/archive/", label: "← 06 論文・資料へ" }}
          next={{ href: "/portal/contact/", label: "09 お問い合わせへ →" }}
        />
      </div>
    </section>
  </div>
</PortalLayout>

<style>
  #cma08-content.cma08-wrap {
    width: 100%;
    max-width: 960px;
    margin: 0 auto;
    padding: 40px 16px 80px;
    color: var(--cma-text);
    font-family: "Noto Sans JP", system-ui, sans-serif;
    text-align: left;
    scroll-margin-top: 80px;
    overflow-wrap: anywhere;
    box-sizing: border-box;
  }
  #cma08-content, #cma08-content * { box-sizing: border-box; }
  #cma08-content a:focus-visible { outline: 3px solid var(--cma-gold); outline-offset: 4px; border-radius: 4px; }
  #cma08-content .cma08-card {
    background: var(--cma-surface);
    border: 1px solid var(--cma-border);
    border-radius: 24px;
    padding: clamp(28px, 5vw, 56px);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.04);
  }
  #cma08-content .cma08-header {
    border-bottom: 1px solid var(--cma-border);
    padding-bottom: 24px;
    margin-bottom: 28px;
  }
  #cma08-content .cma08-badge {
    display: inline-block;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--cma-gold);
    background: var(--cma-gold-soft);
    border: 1px solid var(--cma-gold-faint);
    padding: 4px 10px;
    border-radius: 6px;
    margin-bottom: 12px;
  }
  #cma08-content .cma08-name {
    font-family: Georgia, "Noto Serif JP", serif;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    font-weight: 800;
    color: var(--cma-text);
    margin: 0 0 4px;
    line-height: 1.3;
  }
  #cma08-content .cma08-en-name {
    font-family: Georgia, serif;
    font-size: 1.1rem;
    color: var(--cma-secondary);
    font-style: italic;
    margin-bottom: 8px;
  }
  #cma08-content .cma08-role {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--cma-gold);
  }
  #cma08-content .cma08-bio {
    color: var(--cma-secondary);
    line-height: 1.85;
    font-size: 0.98rem;
    margin-bottom: 32px;
  }
  #cma08-content .cma08-links-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--cma-text);
    margin-bottom: 16px;
    padding-left: 12px;
    border-left: 4px solid var(--cma-gold);
  }
  #cma08-content .cma08-links-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 12px;
    margin-bottom: 36px;
  }
  #cma08-content .cma08-link-card {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 16px;
    background: var(--cma-card-bg);
    border: 1px solid var(--cma-border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--cma-text);
    transition: all 0.2s ease;
  }
  #cma08-content .cma08-link-card:hover {
    background: #F8F5EE;
    border-color: var(--cma-gold);
    transform: translateY(-2px);
  }
  #cma08-content .cma08-link-info strong {
    display: block;
    font-size: 0.92rem;
    color: var(--cma-text);
  }
  #cma08-content .cma08-link-info strong.orcid-heading {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  #cma08-content .orcid-icon {
    flex-shrink: 0;
    vertical-align: middle;
  }
  #cma08-content .cma08-link-info span {
    font-size: 0.78rem;
    color: var(--cma-muted);
  }
  #cma08-content .cma08-link-arrow {
    color: var(--cma-gold);
    font-weight: 700;
  }
  @media (max-width: 768px) {
    #cma08-content.cma08-wrap { padding: 24px 12px 60px; }
    #cma08-content .cma08-card { padding: 24px 16px; border-radius: 18px; }
  }
  @media (prefers-reduced-motion: reduce) {
    #cma08-content .cma08-link-card {
      transition: none !important;
      transform: none !important;
    }
  }
</style>
