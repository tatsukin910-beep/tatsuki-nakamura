---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  robots?: string;
  canonicalUrl?: string;
  ogType?: "website" | "article";
  jsonLd?: string;
  homeHref?: string;
  gateHref?: string;
}

const {
  title,
  description,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  canonicalUrl = new URL(Astro.url.pathname, Astro.site ?? "https://tatsuki-nakamura.com").toString(),
  ogType = "article",
  jsonLd,
  homeHref = "/portal/",
  gateHref = "/"
} = Astro.props;

const defaultJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "WebPage",
  "url": canonicalUrl,
  "name": title,
  "description": description,
  "inLanguage": "ja",
  "isPartOf": {
    "@id": "https://tatsuki-nakamura.com/#website"
  },
  "author": {
    "@type": "Person",
    "@id": "https://tatsuki-nakamura.com/#person",
    "name": "中村達希",
    "identifier": {
      "@type": "PropertyValue",
      "propertyID": "ORCID",
      "value": "0009-0004-9696-7896",
      "url": "https://orcid.org/0009-0004-9696-7896"
    }
  },
  "about": {
    "@id": "https://doi.org/10.5281/zenodo.24218373"
  }
});

const structuredData = jsonLd ?? defaultJsonLd;
---

<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{title}</title>
  <meta name="description" content={description}>
  <meta name="author" content="中村達希 (Tatsuki Nakamura)">
  <meta name="keywords" content="複合的多層的虐待,CMA,Complex Multilayered Abuse,当事者研究,支援困難,制度的無応答,ガスライティング,閉鎖環境">
  <meta name="robots" content={robots}>
  <meta name="theme-color" content="#0B1220">
  <link rel="canonical" href={canonicalUrl}>

  <!-- OGP / SNS Share -->
  <meta property="og:site_name" content="中村達希 公式研究サイト｜CMA">
  <meta property="og:type" content={ogType}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:url" content={canonicalUrl}>
  <meta property="og:locale" content="ja_JP">
  <meta name="twitter:card" content="summary">
  <meta name="twitter:site" content="@tatsu97910">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>

  <link rel="stylesheet" href="/assets/css/style.css">
  <script type="application/ld+json" set:html={structuredData} />
  <slot name="head" />
</head>
<body>
  <a class="skip-link" href="#content">本文へ進む</a>
  <p class="draft-bar">確認用の下書きです。本番の <a href="https://tatsuki-nakamura.com">tatsuki-nakamura.com</a> は切り替えていません。</p>
  <div id="home" class="cma-home-root">
    <Header homeHref={homeHref} gateHref={gateHref} />
    <main id="content">
      <slot />
    </main>
    <Footer />
  </div>

  <script is:inline>
    (function () {
      var key = "cma-theme";
      var root = document.documentElement;
      var btn = document.getElementById("contrast-toggle");
      var live = document.getElementById("theme-status");
      function apply(on, announce) {
        root.setAttribute("data-theme", on ? "invert" : "standard");
        if (btn) btn.setAttribute("aria-pressed", on ? "true" : "false");
        var meta = document.querySelector('meta[name="theme-color"]');
        if (meta) meta.setAttribute("content", on ? "#111111" : "#FAF8F5");
        try { localStorage.setItem(key, on ? "invert" : "standard"); } catch (e) {}
        if (announce && live) live.textContent = on ? "白黒反転にしました" : "標準の色に戻しました";
      }
      var saved = null;
      try { saved = localStorage.getItem(key); } catch (e) {}
      var prefer = window.matchMedia("(prefers-contrast: more)").matches;
      apply(saved ? saved === "invert" : prefer, false);
      if (btn) btn.addEventListener("click", function () {
        apply(root.getAttribute("data-theme") !== "invert", true);
      });
    })();
  </script>
</body>
</html>
